    {
        "id": "comment_raw",
        "type": "comment",
        "z": "tab_raw",
        "name": "Send Raw RouterOS API Commands",
        "info": "This flow demonstrates how to send raw RouterOS API commands to a MikroTik device.\n\n1. Configure the mikrotik-device config node with your router IP, username and password.\n2. Choose one of the inject nodes below to send a command.\n3. View the result in the debug panel.\n\nFor simple commands set msg.payload to a string.\nFor commands with parameters set msg.payload to an array of words.\n\nCommands that return no data (add, set, remove) resolve with an empty array [].",
        "x": 240,
        "y": 80,
        "wires": []
    },
    {
        "id": "inject_print_addresses",
        "type": "inject",
        "z": "tab_raw",
        "name": "Print IP Addresses",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "/ip/address/print",
        "payloadType": "str",
        "x": 220,
        "y": 180,
        "wires": [["mikrotik_raw"]]
    },
